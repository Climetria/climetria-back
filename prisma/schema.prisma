// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  Role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id                      String          @id @default(cuid())
  name                    String
  description             String?
  startDate               DateTime        @db.Date
  endDate                 DateTime        @db.Date
  mentorCourses           MentorCourse[]
  organizationCourses     OrganizationCourse[]
  internCourses           InternCourse[] 
  mentorAssignments       MentorAssignment[]
  internAssignments       InternAssignment[]
  orgCertificateCourses   OrganizationCertificateCourse[]
  grades                  Grade[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  deletedAt               DateTime? 
}

model Mentor {
  id                  String        @id @default(cuid())
  documentType        DocumentType   
  document            String        @unique @db.VarChar(15)
  email               String        @unique
  cognitoUser         String        @default("")
  firstNames          String
  lastNameFather      String
  lastNameMother      String
  phone               String
  country             String
  peruDepartment      PeruDepartment?
  mentorCourses       MentorCourse[]
  mentorAssignments   MentorAssignment[]
  grades              Grade[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
}

model MentorCourse {
  id        String   @id @default(cuid())
  mentorId  String
  courseId  String
  createdAt DateTime @default(now())

  mentor    Mentor   @relation(fields: [mentorId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([mentorId, courseId])
}

model Organization {
  id                      String   @id @default(cuid())
  ruc                     String   @unique
  email                   String   @unique
  contactName             String
  phone                   String   @db.VarChar(15)
  country                 String
  organizationName        String
  organizationSize        OrganizationSize
  sector                  String
  topicsOfInterest        TopicCode[]
  logoUrl                 String?
  signerFullName          String?
  signerTitle             String?
  signerSignatureUrl      String?
  organizationCourses     OrganizationCourse[]
  mentorAssignments       MentorAssignment[]
  internAssignments       InternAssignment[]
  grades                  Grade[]
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
}

model OrganizationCourse {
  id                      String   @id @default(cuid())
  organizationId          String
  courseId                String
  maximumNumberOfInterns  Int
  placeOfResidenceFilter  PeruDepartment[]
  studiedMajorFilter      Major[]
  genderFilter            GenderSelection
  extraRequirements       String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime  @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id])
  course          Course         @relation(fields: [courseId], references: [id])

  @@unique([organizationId, courseId])
}

model Intern {
  id                  String        @id @default(cuid())
  documentType        DocumentType   
  document            String        @unique @db.VarChar(15)
  email               String        @unique
  firstNames          String
  lastNameFather      String
  lastNameMother      String
  gender              Gender
  phone               String        @db.VarChar(15)
  universityName      String
  majorInProgress     Major
  otherMajor          String?
  graduationYear      Int
  referralSource      String
  topicsOfInterest    TopicCode[]   
  country             String
  peruDepartment      PeruDepartment?
  internCourses       InternCourse[]
  internAssignments   InternAssignment[]
  grades              Grade[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
}

model InternCourse {
  id        String   @id @default(cuid())
  internId  String
  courseId  String
  createdAt DateTime @default(now())

  intern    Intern   @relation(fields: [internId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([internId, courseId]) 
}

model MentorAssignment {
  id             String       @id @default(cuid())
  mentorId       String
  organizationId String
  courseId       String
  createdAt      DateTime     @default(now())

  mentor         Mentor       @relation(fields: [mentorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  course         Course       @relation(fields: [courseId], references: [id])

  @@unique([mentorId, organizationId, courseId]) 
}

model InternAssignment {
  id             String       @id @default(cuid())
  internId       String
  organizationId String
  courseId       String
  createdAt      DateTime     @default(now())

  intern         Intern       @relation(fields: [internId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  course         Course       @relation(fields: [courseId], references: [id])

  @@unique([internId, organizationId, courseId]) 
}

model OrganizationCertificate {
  id                      String          @id @default(cuid())
  name                    String          @unique
  logoUrl                 String?
  signerFullName          String?
  signerTitle             String?
  signerSignatureUrl      String?
  orgCertificateCourses   OrganizationCertificateCourse[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?
}

model OrganizationCertificateCourse {
  id                String                    @id @default(cuid())
  orgCertificateId  String
  courseId          String
  createdAt         DateTime                  @default(now())

  orgCertificate    OrganizationCertificate   @relation(fields: [orgCertificateId], references: [id])
  course            Course                    @relation(fields: [courseId], references: [id])

  @@unique([orgCertificateId, courseId]) 
}

model Grade {
  id                     String       @id @default(cuid())
  internId               String
  courseId               String
  mentorId               String?
  organizationId         String?
  s1                     Attendance? 
  s2                     Attendance? 
  s3                     Attendance? 
  s4                     Attendance?
  s5                     Attendance?
  s6                     Attendance?    
  initialCommitment      Int? 
  assertiveCommunication Int?
  punctuality            Int?
  classParticipation     Int?
  proactivity            Int?
  communicationSkills    Int?
  punctualityOfDelivery  Int?
  redaction              Int?
  performance            Int?
  recommendation         String?
  finalReportCheck       Boolean      @default(false)
  talkCheck              Boolean      @default(false)
  recommendationCheck    Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  intern                 Intern         @relation(fields: [internId], references: [id])
  course                 Course         @relation(fields: [courseId], references: [id])
  mentor                 Mentor?        @relation(fields: [mentorId], references: [id])
  organization           Organization?  @relation(fields: [organizationId], references: [id])
  
  @@unique([internId, courseId])
}

enum Role {
  ADMIN
  MENTOR
}

enum DocumentType {
  DNI
  CE
  PASSPORT
}

enum OrganizationSize {
  SMALL  // Micro or Small
  LARGE  // Medium or Large
}

enum TopicCode {
  HC  // Carbon Footprint and Climate Change
  HH  // Water Footprint and Responsible Water Management
  CN  // Carbon Neutrality
}

enum Major {
  Ingenieria_Ambiental @map("ENVIRONMENTAL_ENGINEERING")
  Ingenieria_Forestal @map("FOREST_ENGINEERING")
  Biologia @map("BIOLOGY")
  Gestion_Ambientas @map("ENVIRONMENTAL_MANAGEMENT")
  Otras @map("OTHERS")
}

enum PeruDepartment {
  AMAZONAS
  ANCASH
  APURIMAC
  AREQUIPA
  AYACUCHO
  CAJAMARCA
  CALLAO
  CUSCO
  HUANCAVELICA
  HUANUCO
  ICA
  JUNIN
  LA_LIBERTAD
  LAMBAYEQUE
  LIMA_METROPOLITANA
  LIMA_PROVINCIAS
  LORETO
  MADRE_DE_DIOS
  MOQUEGUA
  PASCO
  PIURA
  PUNO
  SAN_MARTIN
  TACNA
  TUMBES
  UCAYALI
}

enum Gender {
  Masculino @map("MALE")
  Femenino @map("FEMALE")
  Prefiero_No_Decirlo @map("I_PREFER_NOT_TO_SAY_IT")
}

enum GenderSelection {
  Unicamente_Masculino @map("MALE_ONLY")
  Unicamente_Femenino @map("FEMALE_ONLY")
  Ambos @map("BOTH")
}

enum Attendance {
  A
  T
  F
  FJ
}
