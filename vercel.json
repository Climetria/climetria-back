{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "yarn vercel-build && mkdir -p public",
  "outputDirectory": "public",
  "regions": [
    "cle1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist,prisma}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
